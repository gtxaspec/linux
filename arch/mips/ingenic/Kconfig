config INGENIC_XBURST2_SMP
	bool
	depends on (MACH_A1 || MACH_T40 || MACH_T41) && SMP
	default y
	help
	  Starts the second core of the XBurst2 CPU (A1, T40, T41) through the core
	  control unit and sends it inter-processor interrupts through the
	  CCU mailboxes. CPU hotplug is not supported.

config INGENIC_XBURST_MXU2
	bool "XBurst MXU2 SIMD unit"
	depends on MACH_T10 || MACH_T20 || MACH_T21 || MACH_T23 || MACH_T30 || MACH_T31 || \
		   MACH_T32 || MACH_T33
	default y
	help
	  Lets user space use the 128-bit MXU2 SIMD unit (coprocessor 2) of
	  the XBurst1 cores in the Ingenic T-series. A task gets the unit on
	  its first MXU2 instruction and the kernel saves its registers across
	  context switches. Parts without a usable MXU2 (T21, T23) are found
	  at boot and keep raising SIGILL.

config INGENIC_TX_ISP_DEPS
	tristate "Kernel support for the out-of-tree Ingenic tx-isp driver"
	depends on MEDIA_CONTROLLER && VIDEO_DEV
	select VIDEO_V4L2_SUBDEV_API
	select VIDEOBUF2_CORE
	select VIDEOBUF2_V4L2
	select VIDEOBUF2_MEMOPS
	help
	  The T10/T20 tx-isp driver and its helix encoder client are built out
	  of tree against this kernel and use videobuf2, which no in-tree
	  driver selects on these SoCs. Say M to build the videobuf2 modules
	  they load.
