// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include "t40.dtsi"

/ {
	compatible = "thingino,t40", "ingenic,t40";
	model = "Thingino T40 Generic Board";

	aliases {
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c3 = &i2c3;
		mmc0 = &msc0;
		mmc1 = &msc1;
		serial1 = &uart1;
	};

	chosen {
		stdout-path = "serial1:115200n8";
	};

	/* the smallest RAM a T40 comes with; the boot loader's mem= has the real map */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x8000000>;
	};

	/* the 3.3 V rail of the USB PHY */
	vcc_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	/*
	 * The media memory of the out-of-tree camera stack, where thingino's
	 * U-Boot puts it on this RAM size; its rmem= places and enables it
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		rmem: rmem@4000000 {
			reg = <0x4000000 0x4000000>;
			no-map;
			status = "disabled";
		};

		/* the NNA's memory, where nmem= puts it */
		nmem: nmem@7000000 {
			reg = <0x7000000 0x1000000>;
			no-map;
			status = "disabled";
		};
	};
};

&exclk {
	clock-frequency = <24000000>;
};

&uart1 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart1>;
};

&sfc {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pins_sfc>;

	/* partitions come from the mtdparts= the boot loader passes */
	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;
	};
};

&msc0 {
	status = "okay";
	bus-width = <4>;
	max-frequency = <25000000>;
	broken-cd;
	no-1-8-v;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_mmc0>;
};

/* The SDIO Wi-Fi sits on MSC1 (PB17 to PB22); enable it with its power sequence */
&msc1 {
	status = "disabled";
	bus-width = <4>;
	max-frequency = <25000000>;
	non-removable;
	no-1-8-v;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_mmc1>, <&pins_mmc1_c_idle>;
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c0>;
};

&i2c1 {
	status = "okay";
	clock-frequency = <100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c1>;
};

&i2c3 {
	status = "okay";
	clock-frequency = <100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c3>;
};

&isp {
	/* consumed by the out-of-tree ISP modules, not bound by a driver */
	pinctrl-names = "default";
	pinctrl-0 = <&pins_cim_mclk>;

	memory-region = <&rmem>;
};

&i2d {
	/* /dev/i2d (libimp rotation), bound by the out-of-tree i2d module */
	status = "okay";
};

&aic {
	status = "okay";
};

&codec {
	status = "okay";
};

/* left disabled: a profile with a DMIC enables it, the pins may be GPIOs elsewhere */
&dmic {
	pinctrl-names = "default";
	pinctrl-0 = <&pins_dmic>;
};

&sadc {
	status = "okay";
};

&otg_phy {
	status = "okay";

	vcc-supply = <&vcc_3v3>;
};

&otg {
	status = "okay";
	disable-over-current;
};

&dtrng {
	status = "okay";
};

/* The pins stay in GPIO mode until a board user selects a PWM pin group */
&pwm {
	status = "okay";
};

&efuse {
	status = "okay";
};

&mac {
	status = "okay";

	phy-mode = "rmii";
	phy-handle = <&eth_phy>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_mac>;
};

&mdio {
	eth_phy: ethernet-phy@0 {
		reg = <0>;
	};
};

&nna {
	status = "okay";
};

&bscaler {
	status = "okay";
};

&pinctrl {
	pins_uart1: uart1 {
		function = "uart1";
		groups = "uart1-data";
	};

	pins_sfc: sfc0 {
		function = "sfc";
		groups = "sfc-data", "sfc-clk", "sfc-ce";
	};

	pins_mmc0: mmc0 {
		function = "mmc0";
		groups = "mmc0-1bit", "mmc0-4bit";
	};

	pins_mmc1: mmc1 {
		function = "mmc1";
		groups = "mmc1-1bit-b", "mmc1-4bit-b";
	};

	/*
	 * MSC1 can also come out on PC8..PC13, and the boot loader may leave
	 * them muxed to it: as inputs they cannot take over CMD and DAT from
	 * the group in use
	 */
	pins_mmc1_c_idle: mmc1-c-idle {
		pins = "PC8", "PC9", "PC10", "PC11", "PC12", "PC13";
		input-enable;
	};

	pins_i2c0: i2c0 {
		function = "i2c0";
		groups = "i2c0-data-a";
	};

	pins_i2c1: i2c1 {
		function = "i2c1";
		groups = "i2c1-data-a";
	};

	pins_i2c3: i2c3 {
		function = "i2c3";
		groups = "i2c3-data-b";
	};

	pins_mac: mac {
		function = "mac";
		groups = "mac-rmii", "mac-mdio";
	};

	pins_dmic: dmic {
		function = "dmic";
		groups = "dmic";
	};

	/* the sensor's MCLK source is picked at run time: all three pads get the CIM function */
	pins_cim_mclk: cim-mclk {
		function = "cim";
		groups = "cim0-mclk", "cim1-mclk", "cim2-mclk";
	};
};
