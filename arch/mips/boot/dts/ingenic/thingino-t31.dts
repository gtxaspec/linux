// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "t31.dtsi"

/ {
	compatible = "thingino,t31", "ingenic,t31";
	model = "Thingino T31 Generic Board";

	aliases {
		serial1 = &uart1;
	};

	chosen {
		stdout-path = "serial1:115200n8";
	};

	/* the smallest RAM a T31 comes with; the boot loader's mem= has the real map */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x4000000>;
	};

	/*
	 * The media memory of the out-of-tree camera stack, where thingino's
	 * U-Boot puts it on this RAM size; its rmem= places and enables it
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		rmem: rmem@2900000 {
			reg = <0x2900000 0x1700000>;
			no-map;
			status = "disabled";
		};
	};
};

&exclk {
	clock-frequency = <24000000>;
};

&uart1 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart1>;
};

&tcu {
	/* 750 kHz for the system timer and clocksource; SYSOST is sched_clock */
	assigned-clocks = <&tcu TCU_CLK_TIMER0>, <&tcu TCU_CLK_TIMER1>;
	assigned-clock-rates = <750000>, <750000>;
};

&sfc {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "env";
				reg = <0x40000 0x10000>;
			};

			partition@50000 {
				label = "kernel";
				reg = <0x50000 0x200000>;
			};

			partition@250000 {
				label = "rootfs";
				reg = <0x250000 0x500000>;
			};

			partition@750000 {
				label = "rootfs_data";
				reg = <0x750000 0xb0000>;
			};

			partition-all@0 {
				label = "all";
				reg = <0x0 0x1000000>;
			};
		};
	};
};

&msc0 {
	status = "okay";
	bus-width = <4>;
	max-frequency = <24000000>;
	/* thingino's T31 default card detect, high with a card in */
	cd-gpios = <&gpb 27 GPIO_ACTIVE_HIGH>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_mmc0>;
};

&isp {
	/* consumed by the out-of-tree ISP modules, not bound by a driver */
	pinctrl-names = "default";
	pinctrl-0 = <&pins_cim_mclk>;

	memory-region = <&rmem>;
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c0>;
};

/*
 * PB25/PB26 carry IR-cut or Wi-Fi power on most T31 cameras; a camera that
 * uses I2C1 enables it in its own device tree.
 */
&i2c1 {
	status = "disabled";
	clock-frequency = <100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c1>;
};

&dtrng {
	status = "okay";
};

&efuse {
	status = "okay";
};

/ {
	vcc_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&otg_phy {
	status = "okay";

	vcc-supply = <&vcc_3v3>;
};

&otg {
	status = "okay";
	disable-over-current;
};

&mac {
	status = "okay";

	phy-mode = "rmii";
	phy-handle = <&eth_phy>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_mac>;
};

&aic {
	status = "okay";
};

&codec {
	status = "okay";
};

&mdio {
	eth_phy: ethernet-phy@0 {
		reg = <0>;
	};
};

&pinctrl {
	pins_uart1: uart1 {
		function = "uart1";
		groups = "uart1-data-b";
	};

	pins_mac: mac {
		function = "mac";
		groups = "mac-rmii";
	};

	pins_mmc0: mmc0 {
		function = "mmc0";
		groups = "mmc0-1bit", "mmc0-4bit";
	};

	pins_cim_mclk: cim-mclk {
		function = "cim";
		groups = "cim-mclk";
	};

	pins_i2c0: i2c0 {
		function = "i2c0";
		groups = "i2c0-data";
	};

	pins_i2c1: i2c1 {
		function = "i2c1";
		groups = "i2c1-data-b";
	};
};

&ipu {
	memory-region = <&rmem>;
};
