// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>

#include "t23.dtsi"

/ {
	compatible = "thingino,t23", "ingenic,t23";
	model = "Thingino T23N";

	aliases {
		serial1 = &uart1;
	};

	chosen {
		stdout-path = "serial1:115200n8";
	};

	memory@0 {
		device_type = "memory";
		/*
		 * 64 MiB as the T23N ships (the T23DL has 32 MiB); the split with
		 * the ISP memory is U-Boot's
		 */
		reg = <0x0 0x4000000>;
	};

	/*
	 * The media memory of the out-of-tree camera stack, where thingino's
	 * U-Boot puts it on this RAM size; its rmem= places and enables it
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		rmem: rmem@2900000 {
			reg = <0x2900000 0x1700000>;
			no-map;
			status = "disabled";
		};
	};
};

&exclk {
	clock-frequency = <24000000>;
};

&uart1 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart1>;
};

&tcu {
	/* 750 kHz for the system timer and clocksource; SYSOST is sched_clock */
	assigned-clocks = <&tcu TCU_CLK_TIMER0>, <&tcu TCU_CLK_TIMER1>;
	assigned-clock-rates = <750000>, <750000>;
};

&sfc {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pins_sfc>;

	/*
	 * The 8 MiB NOR of the bench camera (thingino camera config
	 * cinnado_d1_t23n_sc2336_atbm6012bx, FLASH_SIZE_MB=8). The layout is
	 * the current thingino Makefile's (U-Boot 320K, env 64K, backup 64K,
	 * kernel 1600K, then the rootfs and data split of the image); never
	 * checked against the bench NOR, so everything is read-only.
	 */
	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x0 0x50000>;
				read-only;
			};

			partition@50000 {
				label = "env";
				reg = <0x50000 0x10000>;
				read-only;
			};

			partition@60000 {
				label = "backup";
				reg = <0x60000 0x10000>;
				read-only;
			};

			partition@70000 {
				label = "kernel";
				reg = <0x70000 0x190000>;
				read-only;
			};

			partition@200000 {
				label = "rootfs_data";
				reg = <0x200000 0x600000>;
				read-only;
			};

			partition-all@0 {
				label = "all";
				reg = <0x0 0x800000>;
				read-only;
			};
		};
	};
};

&msc0 {
	status = "okay";
	bus-width = <4>;
	max-frequency = <24000000>;
	/*
	 * The camera config puts the card detect on PB18 (gpio.mmc_cd 50) but
	 * its polarity is unverified; the pads are PB0-PB5 (KOPT_MMC0_PB_4BIT)
	 */
	broken-cd;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_mmc0>;
};

&isp {
	/*
	 * consumed by the out-of-tree ISP modules, not bound by a driver; a
	 * board with two or three sensors behind a MIPI switch adds a
	 * "mipi-switch" state (pins_cim_mclk and pins_cim_mipi_switch), which
	 * the ISP selects when it hands the switch pad to the VIC
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&pins_cim_mclk>;

	memory-region = <&rmem>;
};

&helix {
	/* the H.264/JPEG encoder, bound by the out-of-tree soc-vpu module */
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c0>;
};

&sadc {
	status = "okay";
};

&dtrng {
	status = "okay";
};

&efuse {
	status = "okay";
};

/ {
	vcc_3v3: regulator-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&otg_phy {
	status = "okay";

	vcc-supply = <&vcc_3v3>;
};

&otg {
	status = "okay";
	disable-over-current;
};

&pinctrl {
	pins_uart1: uart1 {
		function = "uart1";
		groups = "uart1-data-b";
	};

	pins_mmc0: mmc0 {
		function = "mmc0";
		groups = "mmc0-1bit", "mmc0-4bit";
	};

	pins_sfc: sfc {
		function = "sfc";
		groups = "sfc-data";
	};

	pins_cim_mclk: cim-mclk {
		function = "cim";
		groups = "cim-mclk";
	};

	/* for a board with sensors behind a MIPI switch, see &isp */
	pins_cim_mipi_switch: cim-mipi-switch {
		function = "cim";
		groups = "cim-mipi-switch-a7";
	};

	pins_i2c0: i2c0 {
		function = "i2c0";
		groups = "i2c0-data";
	};
};

&aic {
	status = "okay";
};

&codec {
	/* Galayou Y4: thingino.json gpio.speaker {"pin": 39, "active_low": true} = PB7 */
	spk-gpios = <&gpb 7 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&ipu {
	memory-region = <&rmem>;
};
