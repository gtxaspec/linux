// SPDX-License-Identifier: GPL-2.0
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include "t21.dtsi"

/ {
	compatible = "thingino,t21", "ingenic,t21";
	model = "Thingino T21N";

	aliases {
		serial1 = &uart1;
	};

	chosen {
		stdout-path = "serial1:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x4000000>;
	};
};

&exclk {
	clock-frequency = <24000000>;
};

&uart1 {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pins_uart1>;
};

&tcu {
	/* 750 kHz for the system timer and clocksource; SYSOST is sched_clock */
	assigned-clocks = <&tcu TCU_CLK_TIMER0>, <&tcu TCU_CLK_TIMER1>;
	assigned-clock-rates = <750000>, <750000>;
};

&sfc {
	status = "okay";

	pinctrl-names = "default";
	pinctrl-0 = <&pins_sfc>;

	/*
	 * The bench T21N's NOR has a bad block at 0xa30000, so it is described
	 * read-only: nothing here may write it. The layout is thingino's.
	 */
	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "boot";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "env";
				reg = <0x40000 0x10000>;
				read-only;
			};

			partition@50000 {
				label = "kernel";
				reg = <0x50000 0x200000>;
				read-only;
			};

			partition@250000 {
				label = "rootfs";
				reg = <0x250000 0x500000>;
				read-only;
			};

			partition@750000 {
				label = "rootfs_data";
				reg = <0x750000 0xb0000>;
				read-only;
			};

			partition-all@0 {
				label = "all";
				reg = <0x0 0x1000000>;
				read-only;
			};
		};
	};
};

&msc0 {
	status = "okay";
	bus-width = <4>;
	max-frequency = <24000000>;
	/* The bench board's card detect and power pins are unverified */
	broken-cd;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_mmc0>;
};

&isp {
	/* consumed by the out-of-tree ISP modules, not bound by a driver */
	pinctrl-names = "default";
	pinctrl-0 = <&pins_cim_mclk>, <&pins_cim_dvp>;
};

&helix {
	/* the H.264/JPEG encoder, bound by the out-of-tree soc-vpu module */
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_i2c0>;
};

&efuse {
	status = "okay";
};

&dtrng {
	status = "okay";
};

/*
 * The internal PHY talks MII to the MAC (not RMII) at a 25 MHz MAC clock and
 * only needs its two LED pads muxed (the vendor and U-Boot do so). The PHY
 * address is assumed.
 */
&mac {
	status = "okay";

	phy-mode = "mii";
	phy-handle = <&eth_phy>;

	assigned-clocks = <&cgu T21_CLK_MAC>;
	assigned-clock-rates = <25000000>;

	pinctrl-names = "default";
	pinctrl-0 = <&pins_mac>;
};

&mdio {
	eth_phy: ethernet-phy@0 {
		reg = <0>;
	};
};

&pinctrl {
	pins_uart1: uart1 {
		function = "uart1";
		groups = "uart1-data";
	};

	pins_mac: mac {
		function = "mac";
		groups = "mac-ephy-led";
	};

	pins_mmc0: mmc0 {
		function = "mmc0";
		groups = "mmc0-1bit", "mmc0-4bit";
	};

	pins_sfc: sfc {
		function = "sfc";
		groups = "sfc-data";
	};

	pins_cim_mclk: cim-mclk {
		function = "cim";
		groups = "cim-mclk";
	};

	/* the bench sensor's DVP bus: PA low 10 bit data, PCLK, HSYNC, VSYNC */
	pins_cim_dvp: cim-dvp {
		function = "cim";
		groups = "cim-pclk", "cim-sync", "cim-data-10bit";
	};

	pins_i2c0: i2c0 {
		function = "i2c0";
		groups = "i2c0-data";
	};
};

&aic {
	status = "okay";
};

/* Speaker amp enable: PB31 */
&codec {
	spk-gpios = <&gpb 31 GPIO_ACTIVE_LOW>;
	status = "okay";
};
